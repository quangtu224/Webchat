# ============================================================
# Environment variable template. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored - never commit it.
# ============================================================

# --- Server ---
# Port Express listens on
PORT=3000

# development | production
NODE_ENV=development

# --- MongoDB ---
# Local (Docker):    mongodb://localhost:27017/webchat
# Inside compose:    mongodb://mongo:27017/webchat   (mongo = service name)
# Atlas (prod):      mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/webchat
DB_URL=mongodb://localhost:27017/webchat

# --- Limits (Phase 5) ---
MAX_MESSAGE_LENGTH=2000
MAX_AUTHOR_LENGTH=50

# --- Optional: stretch goals ---
# Free key available at https://developers.giphy.com/
# GIPHY_API_KEY=
